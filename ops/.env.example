# ===== PostgreSQL（外部业务库，容器不再内置 db） =====
# 后端服务直连下列外部库；库须预先建好（CREATE DATABASE），表结构与预置数据
# 由应用启动时自动创建/播种（create_all + seed_*，幂等），无需手动执行 init SQL；
# ops/init/*.sql 仅作手动初始化/审阅参考。
# DB_HOST 填外部库地址；若库跑在容器宿主机本机，可填 host.containers.internal
# （podman 4+）或宿主机内网 IP。
DB_HOST=
DB_PORT=5432
DB_NAME=id_x_007
DB_USERNAME=postgres
DB_PASSWORD=

# ===== 初始管理员账号（应用启动播种，幂等） =====
# 目标用户名不存在时由应用启动播种（PBKDF2 哈希落库），留空则默认 admin / admin123；
# 如需预置 sme@cuhk.edu.cn 账号，可手动对外部库执行 ops/init/02_add_user.sql
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ===== CUHK SSO / SMTP 邮件（均存数据库，不走环境变量） =====
# - SSO：pa_sso_settings 表（client_id / client_secret / redirect_uri），启动自动播种；
# - SMTP：pa_smtp_settings 表（host / port / username / password / mail_from），
#   启动播种空白行，运维直接 UPDATE 填写，运行期改表即生效；
#   未配置时跳过发送但仍落库 pa_email_log（status=skipped）。
