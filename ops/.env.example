# ===== PostgreSQL（容器内业务库） =====
POSTGRES_DB=id_x_007
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ===== 初始管理员账号（应用层兜底播种） =====
# 预置管理员已由 ops/init/02_add_user.sql 在数据库初始化时植入（sme@cuhk.edu.cn）；
# 以下变量仅在目标用户名不存在时由应用启动补种（PBKDF2 哈希落库），留空则默认 admin / admin123
PA_ADMIN_USERNAME=
PA_ADMIN_PASSWORD=

# ===== CUHK SSO（ADFS OAuth2 授权码流，student/advisor 登录） =====
PA_OAUTH_CLIENT_ID=
PA_OAUTH_CLIENT_SECRET=
PA_OAUTH_REDIRECT_URI=
# 开发模拟 SSO：置 1 时接受 "mock.<用户名>" 授权码直接登录（仅限本地联调，生产严禁开启）
PA_OAUTH_MOCK=

# ===== SMTP 邮件（预约/取消/提醒通知；未配置则跳过发送但仍落库 pa_email_log） =====
PA_SMTP_HOST=
PA_SMTP_PORT=587
PA_SMTP_USER=
PA_SMTP_PASSWORD=
PA_MAIL_FROM=

# ===== 可选 =====
# 置 1 关闭每日 21:00 预约提醒调度（多实例部署时只保留一个实例开启）
PA_SCHEDULER_DISABLED=
# 批量上传文件大小上限（字节，默认 10MB）
PA_MAX_UPLOAD_BYTES=
# 用户行为审计日志保留天数（默认 90；logs/id_x_007_audit.log 按天轮转自动清理）
PA_AUDIT_RETAIN_DAYS=
