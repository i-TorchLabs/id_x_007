# 后端 API 反代目标（next.config.ts 中 /b/:path* rewrite 的宿主机）
# 本机裸跑后端（uv run python main.py，监听 7000）时填 http://127.0.0.1:7000；
# 留空则默认 http://localhost（80 端口），仅当存在网关时使用
BACKEND_URL=http://127.0.0.1:7000

# ===== 前端构建期注入（NEXT_PUBLIC_* 在 npm run build 时内联，机密信息绝不可放这里） =====
# GraphQL 接口路径
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_SUB_VERSION=/b/id_x_007/graphql
# 站点地址（SSO 回调 redirect_uri 的前缀，须与 ADFS 注册地址一致）
# 默认 https://sme-ugo-appointment.cuhk.edu.cn（见 src/utils/config.ts）
NEXT_PUBLIC_SITE_URL=
# ===== CUHK SSO（ADFS OAuth2 授权码流） =====
# 以下均有生产默认值（config.ts 内联），仅需覆盖时填写；
# client_secret 仅存后端 pa_sso_settings 表，严禁出现在任何 NEXT_PUBLIC_* 中
NEXT_PUBLIC_ADFS_CLIENT_ID=
NEXT_PUBLIC_ADFS_BASE_URL=
NEXT_PUBLIC_ADFS_RESOURCE=
NEXT_PUBLIC_ADFS_REDIRECT_URI=
NEXT_PUBLIC_ADFS_POST_LOGOUT_REDIRECT_URI=
