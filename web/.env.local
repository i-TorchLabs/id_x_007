# 后端 API 反代目标（next.config.ts 中 /b/:path* rewrite 的宿主机；
# 本机裸跑后端时为 http://127.0.0.1:7000，容器/Pod 模式访问统一入口时不经此转发）
BACKEND_URL=http://10.20.217.86:7000

# ===== 前端构建期注入（NEXT_PUBLIC_* 在 npm run build 时内联，机密信息绝不可放这里） =====
# GraphQL 接口路径
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_SUB_VERSION=/b/id_x_007/graphql

# ===== CUHK SSO（ADFS OAuth2；均有生产默认值，见 src/utils/config.ts，仅覆盖时填写）=====
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_ADFS_CLIENT_ID=
NEXT_PUBLIC_ADFS_REDIRECT_URI=
NEXT_PUBLIC_ADFS_RESOURCE=
